{
  "name": "studysky",
  "version": "0.1.0",
  "private": true,
  "description": "Private, self-hosted study workspace for schedules, tasks, revision, documents, and on-device handwriting OCR.",
  "license": "AGPL-3.0-only",
  "author": "StudySky contributors",
  "homepage": "https://github.com/suburb6/StudySky#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suburb6/StudySky.git"
  },
  "bugs": {
    "url": "https://github.com/suburb6/StudySky/issues"
  },
  "keywords": [
    "self-hosted",
    "study-planner",
    "student",
    "sveltekit",
    "postgresql",
    "ocr",
    "pwa"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "ocr:prepare": "node scripts/copy-ocr-runtime.mjs",
    "build": "npm run ocr:prepare && vite build && node scripts/build-worker.mjs",
    "start": "node build",
    "worker": "node build-worker/worker.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --import tsx scripts/seed.ts",
    "hardware:report": "node scripts/hardware-report.mjs",
    "push:keys": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@lucide/svelte": "1.29.0",
    "@node-rs/argon2": "2.0.2",
    "@paddleocr/paddleocr-js": "0.4.2",
    "drizzle-orm": "0.45.2",
    "file-type": "22.0.1",
    "onnxruntime-web": "1.27.0",
    "pdfjs-dist": "6.2.108",
    "pg-boss": "12.27.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "sharp": "0.35.3",
    "svelte": "5.56.8",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.10.2",
    "@types/qrcode": "1.5.6",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "3.4.1",
    "svelte-check": "4.7.4",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "cookie": "1.0.2",
    "esbuild": "0.28.1"
  }
}
