# Required
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://studysky:replace-with-the-same-database-password@localhost:5432/studysky
ORIGIN=https://study.example.com
STUDYSKY_VERSION=v0.1.0

# Storage and upload limits
STORAGE_ROOT=/data/uploads
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
MAX_UPLOAD_BYTES=104857600
MAX_ACTIVE_UPLOAD_SESSIONS=10
BODY_SIZE_LIMIT=110M
MAX_PDF_PROCESSING_PAGES=500

# Authentication
SESSION_DAYS=30
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# Initial administrator (used only by `npm run db:seed`)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=StudySky owner
ADMIN_TIMEZONE=UTC

# Optional: encrypt provider credentials saved in PostgreSQL.
# Generate 32 random bytes and encode as base64.
SETTINGS_ENCRYPTION_KEY=

# Optional OCR worker. Base deployment remains fully usable when false.
OCR_ENABLED=false
OCRMY_PDF_PATH=ocrmypdf
OCR_LANGUAGES=eng
OCR_TIMEOUT_MS=300000

# Optional local handwriting OCR in the browser. Models are integrity-pinned and
# downloaded into this private cache only when an authenticated user first asks.
OCR_MODEL_CACHE_ROOT=/data/uploads/.browser-ocr-models
OCR_MODEL_DOWNLOADS_ENABLED=true

# Optional browser push (in-app notifications work without these)
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Comma-separated extra public push hosts; standard browser vendors are already allowed.
PUSH_ENDPOINT_ALLOWLIST=

# Optional diagnostics/logging
LOG_LEVEL=info
